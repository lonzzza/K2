{
  "swagger": "2.0",
  "info": {
    "version": "1.0.0",
    "title": "Graph Send Mail"
  },
  "host": "graph.microsoft.com",
  "basePath": "/v1.0",
  "schemes": ["https"],
  "paths": {
    "/users/{userId}/sendMail": {
      "post": {
        "operationId": "SendMail",
        "consumes": ["application/json"],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted"
          }
        }
      }
    }
  }
}
